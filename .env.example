DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Required everywhere, including local dev. Sessions are HMAC-signed with
# this — every instance of the app must share the same value, or tokens
# signed by one instance will fail verification on another. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=""

# Public origin of the app, no trailing slash. Used to build the links in verification
# emails and the Google OAuth redirect URI, so in production it must be set (Vercel's
# production-URL variable is used as a fallback). In local dev it defaults to the request host.
APP_URL="http://localhost:3000"

# Email verification (sent through Resend — https://resend.com). EMAIL_FROM must be an address
# on a domain verified in Resend. With no key, dev logs the verification link to the server
# console instead of sending it; production cannot send and reports an error to the user.
RESEND_API_KEY=""
EMAIL_FROM="Extrack <no-reply@yourdomain.com>"

# "Continue with Google" — optional; the button only appears when both are set. Create an OAuth
# 2.0 Web client at https://console.cloud.google.com/apis/credentials and add
# {APP_URL}/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails that can open /admin (analytics, feature-request moderation). The
# account's email must be verified. Leave empty to disable the admin area for everyone.
ADMIN_EMAILS=""

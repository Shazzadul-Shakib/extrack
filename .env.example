DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Required everywhere, including local dev. Sessions are HMAC-signed with
# this — every instance of the app must share the same value, or tokens
# signed by one instance will fail verification on another. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=""

# Public origin of the app, no trailing slash — the exact host you serve it from (with or
# without www). Used to build the links in verification emails, the Google OAuth redirect
# URI, and every canonical URL / sitemap entry for SEO, so in production it must be set at
# build time and runtime (Vercel's production-URL variable is used as a fallback). In local
# dev, emailed links default to the request host.
APP_URL="http://localhost:3000"

# Email verification (sent through Resend — https://resend.com). EMAIL_FROM must be an address
# on a domain verified in Resend. With no key, dev logs the verification link to the server
# console instead of sending it; production cannot send and reports an error to the user.
RESEND_API_KEY=""
EMAIL_FROM="Extrack <no-reply@yourdomain.com>"

# "Continue with Google" — optional; the button only appears when both are set. Create an OAuth
# 2.0 Web client at https://console.cloud.google.com/apis/credentials and add
# {APP_URL}/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails that can open /admin (analytics, feature-request moderation). The
# account's email must be verified. Leave empty to disable the admin area for everyone.
ADMIN_EMAILS=""

# Encrypts each user's pasted Claude/ChatGPT/Gemini API key before storage (see UserSettings
# in schema.prisma) — reversible (AES-256-GCM), unlike SESSION_SECRET's HMAC signing above.
# Required once anyone uses Settings → Receipt scanning. The value below is a placeholder
# generated for this template — replace it with your own via:
#   openssl rand -hex 32
API_KEY_ENCRYPTION_KEY="509a161f815be6ec361b4a8b7c80dd82ba515548c75146266811492d8e6e857a"

# NOTE: no ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY here by design. Unlike
# RESEND_API_KEY (one key the whole app shares), each user pastes their own Claude, ChatGPT,
# or Gemini key into Settings → Receipt scanning; it's encrypted with API_KEY_ENCRYPTION_KEY
# above and stored per-user in the database, used only for that user's own receipt-scan requests.

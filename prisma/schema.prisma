generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WalletType {
  cash
  bank
  savings
  debt
  lend
}

enum TransactionKind {
  expense
  income
  transfer
}

model User {
  id           String   @id
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  passwordSalt String   @map("password_salt")
  createdAt    DateTime @default(now()) @map("created_at")

  wallets      Wallet[]
  transactions Transaction[]
  budgets      Budget[]

  @@map("users")
}

model Wallet {
  id        String     @id
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      WalletType
  balance   Decimal    @default(0) @db.Decimal(14, 2)
  currency  String     @default("BDT")
  note      String     @default("")
  archived  Boolean    @default(false)
  /// Set when the user deletes the wallet. A soft delete: the row and its
  /// transactions stay in the database (history is preserved) but the wallet
  /// drops out of every list, picker, and total. Only an empty wallet
  /// (balance 0) can be deleted.
  deletedAt DateTime?  @map("deleted_at")
  createdAt DateTime   @default(now()) @map("created_at")

  outgoingTransactions Transaction[] @relation("SourceWallet")
  incomingTransfers    Transaction[] @relation("DestinationWallet")

  @@index([userId])
  @@map("wallets")
}

model Transaction {
  id         String          @id
  userId     String          @map("user_id")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId   String          @map("wallet_id")
  wallet     Wallet          @relation("SourceWallet", fields: [walletId], references: [id], onDelete: Cascade)
  toWalletId String?         @map("to_wallet_id")
  toWallet   Wallet?         @relation("DestinationWallet", fields: [toWalletId], references: [id], onDelete: Cascade)
  kind       TransactionKind
  category   String
  amount     Decimal         @db.Decimal(14, 2)
  date       DateTime        @db.Date
  note       String          @default("")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([userId])
  @@index([walletId])
  @@index([toWalletId])
  @@map("transactions")
}

/// A spending limit for one category in one calendar month. A user can set several
/// per month (one per category) — uniqueness is per (user, year, month, category).
model Budget {
  id        String   @id
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  amount    Decimal  @db.Decimal(14, 2)
  year      Int
  month     Int
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, year, month, category])
  @@index([userId, year, month])
  @@map("budgets")
}

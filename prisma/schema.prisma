generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WalletType {
  cash
  bank
  savings
  debt
  lend
}

enum TransactionKind {
  expense
  income
  transfer
}

enum FeatureStatus {
  open
  planned
  in_progress
  shipped
  declined
}

model User {
  id                 String    @id
  name               String
  email              String    @unique
  /// Null for an account that only ever signed in with Google — it has no password to check.
  passwordHash       String?   @map("password_hash")
  passwordSalt       String?   @map("password_salt")
  /// Google's stable account id (the `sub` claim), set once the account signs in with or is linked to Google.
  googleId           String?   @unique @map("google_id")
  /// When the email address was confirmed (by the emailed link, or by Google). A password
  /// account can't sign in until this is set. The column default is what grandfathers in every
  /// user that existed before verification shipped — Postgres backfills existing rows with it
  /// when the column is added. New password signups always pass an explicit null, so they start
  /// unverified; don't rely on the default for a new row.
  emailVerifiedAt    DateTime? @default(now()) @map("email_verified_at")
  /// When the last verification email went out — the resend/re-signup cooldown reads this.
  verificationSentAt DateTime? @map("verification_sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  wallets         Wallet[]
  transactions    Transaction[]
  budgets         Budget[]
  featureRequests FeatureRequest[]
  featureVotes    FeatureVote[]

  @@map("users")
}

model Wallet {
  id        String     @id
  userId    String     @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      WalletType
  balance   Decimal    @default(0) @db.Decimal(14, 2)
  currency  String     @default("BDT")
  note      String     @default("")
  archived  Boolean    @default(false)
  /// Set when the user deletes the wallet. A soft delete: the row and its
  /// transactions stay in the database (history is preserved) but the wallet
  /// drops out of every list, picker, and total. Only an empty wallet
  /// (balance 0) can be deleted.
  deletedAt DateTime?  @map("deleted_at")
  createdAt DateTime   @default(now()) @map("created_at")

  outgoingTransactions Transaction[] @relation("SourceWallet")
  incomingTransfers    Transaction[] @relation("DestinationWallet")

  @@index([userId])
  @@map("wallets")
}

model Transaction {
  id         String          @id
  userId     String          @map("user_id")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId   String          @map("wallet_id")
  wallet     Wallet          @relation("SourceWallet", fields: [walletId], references: [id], onDelete: Cascade)
  toWalletId String?         @map("to_wallet_id")
  toWallet   Wallet?         @relation("DestinationWallet", fields: [toWalletId], references: [id], onDelete: Cascade)
  kind       TransactionKind
  category   String
  amount     Decimal         @db.Decimal(14, 2)
  date       DateTime        @db.Date
  note       String          @default("")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([userId])
  @@index([walletId])
  @@index([toWalletId])
  @@map("transactions")
}

/// A spending limit for one category in one calendar month. A user can set several
/// per month (one per category) — uniqueness is per (user, year, month, category).
model Budget {
  id        String   @id
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  amount    Decimal  @db.Decimal(14, 2)
  year      Int
  month     Int
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, year, month, category])
  @@index([userId, year, month])
  @@map("budgets")
}

/// A user-submitted idea for the app, shown on the "What's new" page's Feature requests tab.
model FeatureRequest {
  id          String        @id
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String        @default("")
  status      FeatureStatus @default(open)
  createdAt   DateTime      @default(now()) @map("created_at")

  votes FeatureVote[]

  @@index([createdAt])
  @@index([userId])
  @@map("feature_requests")
}

/// One user's "like" on a feature request. The composite key is what makes a like idempotent —
/// a user can't like the same request twice.
model FeatureVote {
  featureRequestId String         @map("feature_request_id")
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  userId           String         @map("user_id")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@id([featureRequestId, userId])
  @@index([userId])
  @@map("feature_votes")
}
